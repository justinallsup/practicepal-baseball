{
  "name": "practicepal",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web && node scripts/postexport.js",
    "build:vercel": "expo export --platform web && node scripts/postexport.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build:vercel",
    "serve:test": "node scripts/serve-test.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.8.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2",
    "vitest": "5.0.5"
  },
  "private": true,
  "overrides": {
    "decode-uri-component": "0.5.0",
    "postcss": "8.5.30"
  }
}
